  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Retrouve les comptes de test (client, fournisseur, agent) si les variables sont vides :",
          "// permet de lancer un dossier seul (par exemple 02 - Offres) sans passer par le dossier 01.",
          "const roles = [[\"CLIENT\", \"clientId\"], [\"SUPPLIER\", \"supplierId\"], [\"AGENT\", \"agentId\"], [\"ADMIN\", \"adminId\"]];",
          "if (roles.some(([, variable]) => !pm.collectionVariables.get(variable))) {",
          "  pm.sendRequest({ url: pm.collectionVariables.get(\"baseUrl\") + \"/api/users\", method: \"GET\" }, (error, response) => {",
          "    if (error || response.code !== 200) return;",
          "    const users = response.json();",
          "    roles.forEach(([role, variable]) => {",
          "      const user = users.find((u) => u.role === role && !u.archived);",
          "      if (user) pm.collectionVariables.set(variable, user.id);",
          "    });",
          "  });",
          "}"
        ]
      }
    }
  ]
