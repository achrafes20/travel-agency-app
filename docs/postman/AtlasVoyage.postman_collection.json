    {
      "name": "00 - Statut",
      "item": [
        {
          "name": "GET /api/status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status = ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "status"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 - Utilisateurs",
      "item": [
        {
          "name": "Lister les utilisateurs (et mémoriser les comptes de test)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", () => pm.response.to.have.status(200));",
                  "const users = pm.response.json();",
                  "pm.test(\"Liste non vide, sans mot de passe\", () => { pm.expect(users).to.be.an(\"array\").that.is.not.empty; users.forEach(u => pm.expect(u).to.not.have.property(\"password\")); });",
                  "const first = (role) => (users.find(u => u.role === role && !u.archived) || {}).id;",
                  "[\"CLIENT\", \"SUPPLIER\", \"AGENT\", \"ADMIN\"].forEach(r => { const id = first(r); if (id) pm.collectionVariables.set(r.toLowerCase() + \"Id\", id); });",
                  "pm.test(\"Comptes fournisseur et agent trouvés\", () => { pm.expect(pm.collectionVariables.get(\"supplierId\")).to.exist; pm.expect(pm.collectionVariables.get(\"agentId\")).to.exist; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Créer un utilisateur",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"testEmail\", \"postman.\" + Date.now() + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 201\", () => pm.response.to.have.status(201));",
                  "const u = pm.response.json();",
                  "pm.test(\"Compte créé, non archivé, sans mot de passe\", () => { pm.expect(u.id).to.be.a(\"number\"); pm.expect(u.archived).to.eql(false); pm.expect(u).to.not.have.property(\"password\"); });",
                  "pm.collectionVariables.set(\"userId\", u.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Test\",\n  \"email\": \"{{testEmail}}\",\n  \"role\": \"CLIENT\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Détail d'un utilisateur",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Email attendu\", () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get(\"testEmail\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
