# Exemple ; Spring ne charge pas .env automatiquement (export shell ou IDE).
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/travel_agency_db?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
# Prod : clé Base64 aléatoire >= 32 octets. Aucune valeur réelle ici.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# En production, conserver ces valeurs afin d'imposer les cookies HTTPS.
APP_SECURITY_ALLOW_BEARER_HEADER=false
APP_SECURITY_COOKIE_SECURE=true
# Sandbox uniquement en dev/test ; le profil prod refuse ce fournisseur.
PAYMENT_PROVIDER=sandbox
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_ENABLED=false
MAIL_FROM=noreply@atlasvoyage.test
# Inclut déjà /frontend ; ne pas le dupliquer dans les liens.
APP_BASE_URL=http://localhost:5500/frontend
# Facultatif en dev, défaut password123 ; ne réinitialise pas les comptes existants.
DEMO_PASSWORD=
VOUCHER_SECRET=
# Phase 6 : profils, comptes et images (aucun secret réel ici).
REQUIRE_EMAIL_VERIFICATION=false
MAIL_FROM_NAME=Atlas Voyage
# Adresse publique du Backend, sans /frontend.
API_BASE_URL=http://localhost:8080
STORAGE_TYPE=local
UPLOAD_ROOT=./uploads
UPLOAD_MAX_SIZE_BYTES=5242880
UPLOAD_MAX_REQUEST_SIZE=6MB
FILE_CLEANUP_DRY_RUN=false
ACCOUNT_JOBS_ENABLED=true
